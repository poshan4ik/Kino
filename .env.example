# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# ── Django ──────────────────────────────────────────────
# Секретный ключ (обязателен при DEBUG=False)
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production

# Режим отладки (True — только для разработки)
DEBUG=True

# Хосты, которым разрешён доступ (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1

# Доверенные origin'ы для CSRF (для продакшена, через запятую)
# Пример: CSRF_TRUSTED_ORIGINS=https://your-domain.kz,https://www.your-domain.kz
CSRF_TRUSTED_ORIGINS=

# Часовой пояс проекта
TIME_ZONE=Asia/Almaty

# ── База данных ────────────────────────────────────────
# Использовать SQLite (True) или PostgreSQL (False)
USE_SQLITE=True

# Либо задайте DATABASE_URL одной строкой (приоритет над USE_SQLITE/POSTGRES_*):
# DATABASE_URL=postgres://user:pass@localhost:5432/cinema_db

# Настройки PostgreSQL (заполняются при USE_SQLITE=False)
POSTGRES_DB=cinema_db
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── HTTPS / безопасность (используются при DEBUG=False) ─
# Принудительный редирект на HTTPS (True на хостинге с TLS)
SECURE_SSL_REDIRECT=False

# ── Лимиты бизнес-логики ───────────────────────────────
# Максимум мест в одной брони
BOOKING_MAX_SEATS=10
# Минуты удержания мест до оплаты
BOOKING_HOLD_MINUTES=15
# Буфер на уборку зала между сеансами (минуты)
SESSION_BUFFER_MINUTES=20

# ── Логирование ─────────────────────────────────────────
# Уровень логов Django (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── Автосоздание суперпользователя при деплое ──────────
# (python manage.py ensure_admin; пароль только из переменных окружения)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
